# ---- HubSpot ----
# Private App token with scopes:
#   crm.objects.contacts.read, crm.objects.contacts.write,
#   crm.objects.companies.read, crm.objects.companies.write
# Create one at: HubSpot Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=<your_hubspot_private_app_token>

# ---- Database ----
# Local SQLite file. `dev.db` is created by `npx prisma migrate deploy`.
DATABASE_URL="file:./dev.db"

# ---- Slack (only needed for the scheduled weekly run; unused for interactive scans) ----
# Bot User OAuth Token from your Slack app. Starts with `xoxb-`.
# Scopes: chat:write, im:write, users:read, users:read.email
SLACK_BOT_TOKEN=<your_slack_bot_token>

# Slack user ID to DM. Get yours via Slack → Profile → "Copy member ID".
SLACK_DM_USER_ID=<your_slack_user_id>

# Base URL for links back to the dashboard in the Slack summary.
# Keep as http://localhost:3000 if you only open the dashboard locally.
DEDUPE_DASHBOARD_URL=http://localhost:3000
